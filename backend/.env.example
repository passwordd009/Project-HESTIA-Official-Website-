# ──────────────────────────────────────────────────────────────
#  HESTIA Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────

# Path to your Google Cloud Service Account JSON key file.
# Can be absolute or relative to the backend/ directory.
# Example: ./keys/hestia-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./keys/hestia-service-account.json

# The ID of your Google Sheet.
# Find it in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Port the Express server listens on (optional, default: 3001)
PORT=3001

# Allowed CORS origin — your Vite dev server (optional, default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
