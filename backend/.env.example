# ──────────────────────────────────────────────────────────────
#  HESTIA Backend — Environment Variables
#  Copy this file to .env and fill in your values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# Resend (https://resend.com) API key, used to email form submissions.
RESEND_API_KEY=re_your_api_key_here

# Sender address. Its domain must be verified in Resend.
EMAIL_FROM="Project HESTIA <forms@projecthestia.org>"

# Comma-separated list of who receives form submissions.
EMAIL_TO=elijah@projecthestia.org,jalen@projecthestia.org,projecthestia100@gmail.com

# Port the Express server listens on (default: 3001)
PORT=3001

# Allowed CORS origin — the frontend's URL (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Stripe donations (leave STRIPE_SECRET_KEY empty until the Stripe work is done;
# the donate endpoint returns "not live yet" while it is empty).
STRIPE_SECRET_KEY=
DONATION_SUCCESS_URL=http://localhost:5173/donate/thank-you
DONATION_CANCEL_URL=http://localhost:5173/donate
